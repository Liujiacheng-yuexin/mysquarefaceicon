{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".game-asset-check",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": false,
    "plugins": []
  },
  "include": [
    "data/games/**/*.ts",
    "lib/games/**/*.ts",
    "scripts/validate-game-assets.ts"
  ],
  "exclude": ["node_modules", ".next", ".game-asset-check"]
}
