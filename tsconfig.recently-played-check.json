{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": ".recently-played-check",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": false,
    "plugins": []
  },
  "include": [
    "components/game/RecentlyPlayed.tsx",
    "data/games/**/*.ts",
    "lib/games/**/*.ts",
    "lib/recently-played.ts",
    "scripts/validate-recently-played.tsx"
  ],
  "exclude": ["node_modules", ".next", ".recently-played-check", "app/sitemap.ts"]
}
