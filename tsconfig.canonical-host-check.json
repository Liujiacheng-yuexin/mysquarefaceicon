{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".canonical-host-check",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": false,
    "plugins": []
  },
  "include": [
    "lib/seo/canonical-origin.ts",
    "middleware.ts",
    "scripts/validate-canonical-host.ts"
  ],
  "exclude": ["node_modules", ".next", ".canonical-host-check"]
}
