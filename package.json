{
  "name": "mysquarefaceicon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run ruffle:check && next build",
    "cf:build": "npm run ruffle:check && opennextjs-cloudflare build && node scripts/patch-opennext-worker.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "npm run ruffle:check && opennextjs-cloudflare build && node scripts/patch-opennext-worker.mjs && opennextjs-cloudflare deploy",
    "start": "next start",
    "lint": "next lint",
    "banner:check": "node scripts/check-discord-banner.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "seo:check": "node scripts/seo-check.mjs --base http://localhost:3000",
    "seo:prod": "node scripts/post-deploy-check.mjs --base https://mysquarefaceicon.com",
    "robots:check": "node scripts/check-ai-crawler-policy.mjs --base http://localhost:3000",
    "canonical:check": "node scripts/run-canonical-host-check.mjs",
    "terms:check": "node scripts/check-terms-rights.mjs",
    "about:check": "node scripts/check-about-rights.mjs",
    "editorial:check": "node scripts/check-editorial-rights.mjs",
    "gallery:check": "node scripts/check-gallery-rights.mjs",
    "locale:check": "node scripts/check-locale-rights.mjs",
    "square-home:check": "node scripts/check-square-homepage.mjs",
    "oval-page:check": "node scripts/check-oval-legacy-page.mjs",
    "pixel-page:check": "node scripts/check-pixel-external-page.mjs",
    "games:check": "node scripts/run-game-data-check.mjs",
    "player:check": "node scripts/run-game-player-check.mjs",
    "routes:check": "node scripts/run-game-route-check.mjs",
    "components:check": "node scripts/run-game-component-check.mjs",
    "metadata:check": "node scripts/run-game-metadata-check.mjs",
    "home:check": "node scripts/run-home-information-architecture-check.mjs",
    "home-hero:check": "node scripts/run-home-hero-check.mjs",
    "home-discovery:check": "node scripts/run-home-discovery-check.mjs",
    "home-gallery:check": "node scripts/run-home-gallery-check.mjs",
    "perf-home:check": "node scripts/run-home-performance-check.mjs",
    "game-template:check": "node scripts/run-game-template-check.mjs",
    "games-index:check": "node scripts/check-games-index.mjs",
    "category-sample:check": "node scripts/check-category-sample.mjs",
    "category-remaining:check": "node scripts/check-category-remaining.mjs",
    "related:check": "node scripts/run-related-games-check.mjs",
    "recent:check": "node scripts/run-recently-played-check.mjs",
    "favorites:check": "node scripts/run-favorites-check.mjs",
    "assets:check": "node scripts/run-game-asset-check.mjs",
    "images:check": "node scripts/run-game-image-check.mjs",
    "ruffle:sync": "node scripts/sync-ruffle-runtime.mjs",
    "ruffle:check": "node scripts/check-ruffle-runtime.mjs",
    "quality:code": "npm run lint && npm run build"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.2.0-nightly.2026.5.12",
    "lucide-react": "^0.468.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260511.1",
    "@opennextjs/cloudflare": "^1.3.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "typescript": "^5.5.3",
    "wrangler": "^4.90.1"
  }
