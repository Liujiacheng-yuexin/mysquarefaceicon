{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": ".home-hero-check",
    "rootDir": ".",
    "incremental": false,
    "isolatedModules": false,
    "declaration": false,
    "sourceMap": false,
    "plugins": []
  },
  "include": [
    "components/FlashGenerator.tsx",
    "components/game/GameControls.tsx",
    "components/game-player/**/*.ts",
    "components/game-player/**/*.tsx",
    "components/home/CoreGamePreview.tsx",
    "components/home/HomeHero.tsx",
    "data/games/square-face.ts",
    "lib/games/**/*.ts",
    "scripts/validate-home-hero.tsx"
  ],
  "exclude": ["node_modules", ".next", ".home-hero-check", "app/sitemap.ts"]
}
